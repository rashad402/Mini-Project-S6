# Focus Flow — Server Environment Variables
# Copy this to .env and fill in real values

MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/focusflow?retryWrites=true&w=majority
SESSION_SECRET=your-random-secret-key-change-this
NODE_ENV=production
CLIENT_URL=https://your-frontend.onrender.com
PORT=3000
